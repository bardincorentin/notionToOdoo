# ──────────────────────────────────────────────────────────────────────────────
# notionToOdoo — environment variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Notion ────────────────────────────────────────────────────────────────────
# Your Notion integration secret token.
# Create one at https://www.notion.so/my-integrations
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Odoo ──────────────────────────────────────────────────────────────────────
# Base URL of your Odoo instance (no trailing slash)
ODOO_URL=https://mycompany.odoo.com

# Odoo database name
ODOO_DB=mycompany

# Odoo user login (e-mail)
ODOO_USER=admin@mycompany.com

# Odoo user password
ODOO_PASSWORD=my_secure_password

# (Optional) ID of an existing Odoo Knowledge article to use as parent.
# Leave empty to create articles at the root level.
ODOO_PARENT_ARTICLE_ID=

# (Optional) Path of the SQLite file mapping Notion page IDs to Odoo article
# IDs. Defaults to .notion_odoo_map.db in the working directory.
SYNC_STORE_PATH=

# (Optional) Target Odoo version: 15, 16 or 17. Defaults to 17.
# Odoo 15 uses the legacy document.page model instead of knowledge.article.
ODOO_VERSION=

# ── Timeouts (optional) ───────────────────────────────────────────────────────
# HTTP request timeout in seconds for each API client. Defaults to 30.
NOTION_TIMEOUT=30
ODOO_TIMEOUT=30

# ── Web interface (optional, python -m src.web) ───────────────────────────────
# Bind address and port of the minimal web interface.
WEB_HOST=127.0.0.1
WEB_PORT=5000
